# Copy to .env. Never commit .env.

# Language model, OpenAI-compatible.
#   amd     vLLM on AMD Developer Cloud (the target)
#   other   any other OpenAI-compatible endpoint - shown on the panel as STAND-IN, with KAYRA_LLM_LABEL
#   archive replay recorded calls from artifacts/llm_archive.jsonl
#   none    no model; hand-written stand-in hypotheses, labelled as such
KAYRA_LLM_BACKEND=amd
KAYRA_LLM_BASE_URL=http://<droplet-ip>:8000/v1
KAYRA_LLM_API_KEY=<the --api-key given to vllm serve>
KAYRA_LLM_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct
KAYRA_LLM_LABEL=

# Stand-in while AMD is down (example):
# KAYRA_LLM_BACKEND=other
# KAYRA_LLM_BASE_URL=https://openrouter.ai/api/v1
# KAYRA_LLM_MODEL=qwen/qwen3-coder-30b-a3b-instruct
# KAYRA_LLM_LABEL=OpenRouter, not AMD

# Home Assistant, read-only, for tools/pull_ha.py. A token for Käyrä only.
HA_URL=http://<ha-host>:8123
HA_TOKEN=<long-lived token>
